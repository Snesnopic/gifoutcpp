Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cert-err58-cpp,
  -misc-include-cleaner,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -misc-non-private-member-variables-in-classes,
  -bugprone-easily-swappable-parameters,
  -readability-convert-member-functions-to-static,
  -readability-uppercase-literal-suffix,
  -misc-use-internal-linkage,
  -readability-implicit-bool-conversion,
  -bugprone-infinite-loop,
  -misc-const-correctness,
  -readability-math-missing-parentheses,
  -bugprone-branch-clone,
  -performance-enum-size,
  -readability-avoid-nested-conditional-operator,
  -bugprone-narrowing-conversions,
  -readability-simplify-boolean-expr
WarningsAsErrors: ''
HeaderFilterRegex: '(include|src)/.*\.(hpp|cpp)$'

# why some checks are off:
#   trailing-return-type, braces-around-statements, uppercase-literal-suffix,
#     implicit-bool-conversion: house style
#   non-private-member-variables: the model types are deliberately plain structs
#   use-internal-linkage: it flags the public api, whose definitions live in .cpp
#     files while the declarations sit in include/optigif
#   infinite-loop: it misreads `for (i = n; i-- > 1;)`, where the condition steps
#   easily-swappable-parameters: geometry really does come as (width, height)
#   const-correctness: it flags variables that are mutated through member calls and
#     inside lambdas, so every hit here was a false positive
#   math-missing-parentheses: still fires on expressions that are already parenthesised
#   branch-clone: an argument parser legitimately repeats `x = stoul(argv[++i])`
#   enum-size: the enums it flags already have an explicit uint8_t underlying type
#   narrowing-conversions, simplify-boolean-expr, nested-conditional-operator: every
#     hit was reviewed and was either wrong or a readability trade we already made
